PORT=8080
ALLOWED_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=5
# max questions per minute per IP (protects the Gemini quota)
ASK_PER_MINUTE=5

# Supabase > Project Settings > Database > Connection string (URI)
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# tried in order when the main model is overloaded (503/429) or unavailable
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash,gemini-flash-latest

# cloudinary | supabase
STORAGE_PROVIDER=cloudinary

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=plantdoc

# Only when STORAGE_PROVIDER=supabase (bucket must be PUBLIC)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=plantdoc
